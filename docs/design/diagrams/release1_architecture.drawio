1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Availability · durable acknowledgements and recovery" style="text;html=0;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="30" width="1500" height="50" /></mxCell><mxCell id="subtitle" value="Production spreads replicas across zones; local Kubernetes exercises coordination, not independent-zone resilience" style="text;html=0;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="40" /></mxCell><mxCell id="band0" value="01  STATELESS EDGE AND PROCESS REPLICAS" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="145" width="1500" height="30" /></mxCell><mxCell id="band1" value="02  DATABASE FAILOVER — application replication depends on durable shared state" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="620" width="1500" height="30" /></mxCell><mxCell id="band2" value="03  DELIVERY RULES — at-least-once transport, idempotent effects; no exactly-once claim" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="875" width="1500" height="30" /></mxCell><mxCell id="gate" value="HTTPS gateway / service&#10;&#10;Authorization remains inside application services" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="180" width="500" height="100" /></mxCell><mxCell id="z0" value="Zone A&#10;&#10;API replica&#10;Processor capacity (A / B minimum)&#10;Scheduler capacity (A / B minimum)&#10;Connector pools spread by criticality" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="370" width="440" height="190" /></mxCell><mxCell id="z1" value="Zone B&#10;&#10;API replica&#10;Processor capacity (A / B minimum)&#10;Scheduler capacity (A / B minimum)&#10;Connector pools spread by criticality" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="370" width="440" height="190" /></mxCell><mxCell id="z2" value="Zone C&#10;&#10;API replica&#10;Processor capacity (A / B minimum)&#10;Scheduler capacity (A / B minimum)&#10;Connector pools spread by criticality" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="370" width="440" height="190" /></mxCell><mxCell id="primary" value="PostgreSQL writer&#10;&#10;Inbox + queue + projections&#10;Synchronous policy chosen explicitly&#10;Client retries resolve uncertain commits" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#fff3df;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="675" width="440" height="150" /></mxCell><mxCell id="standby" value="Cross-zone standby&#10;&#10;Automated failover + writer fencing&#10;Acknowledged-event durability depends&#10;on replication and failover policy" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#fff3df;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="675" width="440" height="150" /></mxCell><mxCell id="backup" value="Backups + PITR&#10;&#10;Separate disaster-recovery procedure&#10;Restricted access + restore tests&#10;No active-active region writes in R1" style="rounded=1;whiteSpace=wrap;htm