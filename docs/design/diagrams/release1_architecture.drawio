></Array></mxGeometry></mxCell><mxCell id="edge2" value="route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="gate" target="z2"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="320" /><mxPoint x="1320" y="320" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="DB endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="z0" target="primary"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="280" y="600" /><mxPoint x="280" y="600" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="z1" target="primary"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="600" /><mxPoint x="280" y="600" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="z2" target="primary"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1320" y="600" /><mxPoint x="280" y="600" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="replicate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="primary" target="standby"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge7" value="archive / backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;dashed=1;" edge="1" parent="1" source="standby" target="backup"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="acce