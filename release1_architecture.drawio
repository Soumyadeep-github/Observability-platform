<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="page-0" name="Logical architecture"><mxGraphModel dx="1600" dy="1250" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Release 1 · Python core, open integration boundaries" style="text;html=0;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="30" width="1500" height="50" /></mxCell><mxCell id="subtitle" value="Proposed design · PostgreSQL-backed coordination · Optional catalog · No mandatory internal broker" style="text;html=0;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="40" /></mxCell><mxCell id="band0" value="01  EXISTING SYSTEMS — instrument or query; do not embed their runtimes in the core" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="145" width="1500" height="30" /></mxCell><mxCell id="band1" value="02  INTEGRATION BOUNDARIES — published contracts; isolated dependency families" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="385" width="1500" height="30" /></mxCell><mxCell id="band2" value="03  ONE APPLICATION CODEBASE — separate Kubernetes Deployments; independently scaled" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="655" width="1500" height="30" /></mxCell><mxCell id="band3" value="04  DURABLE STATE — shared transaction boundary, not shared in-memory state" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="930" width="1500" height="30" /></mxCell><mxCell id="air" value="Airflow&#10;&#10;Official OpenLineage provider&#10;Task attempts + parent run IDs&#10;REST reconciliation" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f0fd;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="185" width="330" height="150" /></mxCell><mxCell id="spark" value="Spark batch + streaming&#10;&#10;Existing JVM listener&#10;Microbatch progress + commit evidence&#10;Python hooks only for proven gaps" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f0fd;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="185" width="330" height="150" /></mxCell><mxCell id="flink" value="Flink&#10;&#10;Existing OpenLineage plugin&#10;REST / checkpoint metrics&#10;Column lineage is capability-limited" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f0fd;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="185" width="330" height="150" /></mxCell><mxCell id="data" value="Kafka + GCP sources&#10;&#10;Kafka topics / registry / offsets&#10;BigQuery · Cloud SQL PG / MySQL&#10;Spanner GoogleSQL" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f0fd;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1200" y="185" width="340" height="150" /></mxCell><mxCell id="ol" value="Native OpenLineage ingress&#10;&#10;Airflow / Spark / Flink send existing events&#10;Validate pinned schemas; preserve provenance&#10;Do not wrap or replace the native wire format" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="435" width="500" height="160" /></mxCell><mxCell id="conn" value="Isolated Python connector pools&#10;&#10;Reuse OSS metadata sources through adapters&#10;Official SDKs + SQL for collection gaps&#10;CloudEvents observations + HTTP task leases" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="630" y="435" width="500" height="160" /></mxCell><mxCell id="clients" value="Users + agents&#10;&#10;Python-rendered UI + graph JS&#10;OpenAPI clients / producer hooks&#10;Read-only MCP; shared authorization" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1200" y="435" width="340" height="160" /></mxCell><mxCell id="api" value="API · 3 replicas&#10;&#10;Auth + validation + durable inbox write&#10;REST / OpenLineage / MCP / UI&#10;202 only after PostgreSQL commit" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="705" width="440" height="165" /></mxCell><mxCell id="proc" value="Processor · 2+ replicas&#10;&#10;Normalize + deduplicate + resolve identity&#10;Versioned lineage / schema / DQ / health&#10;Fenced tasks; transactional projections" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="705" width="440" height="165" /></mxCell><mxCell id="sched" value="Scheduler · 2 replicas&#10;&#10;Enqueue due polling + freshness work&#10;Unique occurrence keys in PostgreSQL&#10;No API-local uncoordinated timers" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="705" width="400" height="165" /></mxCell><mxCell id="db" value="HA PostgreSQL&#10;&#10;Inbox + task queue + fenced leases + connector cursors&#10;Current state + versioned history + health transitions + outbox&#10;30+ day configurable history; separate dedupe / audit retention" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#fff3df;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="985" width="760" height="160" /></mxCell><mxCell id="cat" value="Optional catalog&#10;&#10;Async outbox → OpenMetadata / DataHub&#10;Outside core availability path" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#f1f3f5;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="1070" width="300" height="100" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="air" target="ol"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="spark" target="ol"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="605" y="365" /><mxPoint x="450" y="365" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="flink" target="ol"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="985" y="353" /><mxPoint x="525" y="353" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="poll evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;dashed=1;" edge="1" parent="1" source="flink" target="conn"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="pull metadata / metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;dashed=1;" edge="1" parent="1" source="data" target="conn"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1370" y="365" /><mxPoint x="1085" y="365" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="native events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="ol" target="api"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge6" value="observations + work protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="conn" target="api"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="880" y="625" /><mxPoint x="440" y="625" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="clients" target="api"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1370" y="640" /><mxPoint x="120" y="640" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="durable accept" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="api" target="db"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="280" y="1015" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="claim / project" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="proc" target="db"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge10" value="due work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="sched" target="db"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1340" y="1015" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="async" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;dashed=1;" edge="1" parent="1" source="db" target="cat"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="Availability and delivery"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Availability · durable acknowledgements and recovery" style="text;html=0;fontSize=30;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="30" width="1500" height="50" /></mxCell><mxCell id="subtitle" value="Production spreads replicas across zones; local Kubernetes exercises coordination, not independent-zone resilience" style="text;html=0;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="85" width="1500" height="40" /></mxCell><mxCell id="band0" value="01  STATELESS EDGE AND PROCESS REPLICAS" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="145" width="1500" height="30" /></mxCell><mxCell id="band1" value="02  DATABASE FAILOVER — application replication depends on durable shared state" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="620" width="1500" height="30" /></mxCell><mxCell id="band2" value="03  DELIVERY RULES — at-least-once transport, idempotent effects; no exactly-once claim" style="text;html=0;fontSize=16;fontStyle=1;align=left;fontColor=#536176;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="875" width="1500" height="30" /></mxCell><mxCell id="gate" value="HTTPS gateway / service&#10;&#10;Authorization remains inside application services" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="180" width="500" height="100" /></mxCell><mxCell id="z0" value="Zone A&#10;&#10;API replica&#10;Processor capacity (A / B minimum)&#10;Scheduler capacity (A / B minimum)&#10;Connector pools spread by criticality" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="370" width="440" height="190" /></mxCell><mxCell id="z1" value="Zone B&#10;&#10;API replica&#10;Processor capacity (A / B minimum)&#10;Scheduler capacity (A / B minimum)&#10;Connector pools spread by criticality" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="370" width="440" height="190" /></mxCell><mxCell id="z2" value="Zone C&#10;&#10;API replica&#10;Processor capacity (A / B minimum)&#10;Scheduler capacity (A / B minimum)&#10;Connector pools spread by criticality" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#eef0ff;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="370" width="440" height="190" /></mxCell><mxCell id="primary" value="PostgreSQL writer&#10;&#10;Inbox + queue + projections&#10;Synchronous policy chosen explicitly&#10;Client retries resolve uncertain commits" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#fff3df;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="675" width="440" height="150" /></mxCell><mxCell id="standby" value="Cross-zone standby&#10;&#10;Automated failover + writer fencing&#10;Acknowledged-event durability depends&#10;on replication and failover policy" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#fff3df;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="675" width="440" height="150" /></mxCell><mxCell id="backup" value="Backups + PITR&#10;&#10;Separate disaster-recovery procedure&#10;Restricted access + restore tests&#10;No active-active region writes in R1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#f1f3f5;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="675" width="440" height="150" /></mxCell><mxCell id="accept" value="1 · Accept&#10;&#10;Validate → inbox + task transaction&#10;Commit before 202 receipt&#10;Retry returns existing receipt" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="925" width="440" height="165" /></mxCell><mxCell id="work" value="2 · Process&#10;&#10;Claim with expiry + fencing generation&#10;Apply projection + processing marker&#10;Replay safe after worker crash" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="925" width="440" height="165" /></mxCell><mxCell id="cursor" value="3 · Advance / recover&#10;&#10;Advance cursor after durable receipts&#10;Reject stale task completion&#10;Report collector loss separately" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=18;fontSize=16;fillColor=#e8f7f3;strokeColor=#b8c4d4;" vertex="1" parent="1"><mxGeometry as="geometry" x="1100" y="925" width="440" height="165" /></mxCell><mxCell id="edge0" value="route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=13;strokeColor=#68768a;" edge="1" parent="1" source="gate" target="z0"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoi